{
  "load": 0,
  "source": "registry",
  "list": [["web", "apps/web"]],
  "globs": {
    "tddUnitTests": {
      "match": ["apps/web/app/x.test.ts", "apps/web/app/a/x.test.tsx"],
      "noMatch": ["app/x.test.ts", "apps/app/x.test.ts", "apps/web/x.test.ts"]
    }
  },
  "forPath": {
    "apps/web/app/x.ts": "web",
    "apps/x": ""
  },
  "dir": {
    "web": "apps/web"
  }
}
