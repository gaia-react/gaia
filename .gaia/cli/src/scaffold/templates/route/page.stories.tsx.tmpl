import type {Meta, StoryFn} from '@storybook/react-vite';
import {expect, within} from 'storybook/test';
import stubs from 'test/stubs';
import Layout from '~/components/layout';
import {{pageName}} from '../page';

const meta: Meta = {
  component: {{pageName}},
  decorators: [
    (Story) => (
      <Layout>
        <Story />
      </Layout>
    ),
{{#hasLoader}}    // Serves the loader data the page reads. The route's own loader can read
    // request context, such as the i18next instance, that a story lacks.
    stubs.reactRouter({
      loader: async () => ({
        description: 'Description of the {{routeSlug}} page',
        title: '{{pageName}}',
      }),
    }),
{{/hasLoader}}{{#noLoader}}    stubs.reactRouter(),
{{/noLoader}}  ],
  parameters: {
    controls: {hideNoControlsWarning: true},
  },
  title: 'Pages/{{routeName}}',
};

export default meta;

export const Default: StoryFn = () => <{{pageName}} />;

// Starting point only: this checks the page structure. Add interaction
// assertions as the page grows.
export const Renders: StoryFn = () => <{{pageName}} />;

Renders.play = async ({canvasElement}) => {
  const canvas = within(canvasElement);

  const headings = await canvas.findAllByRole('heading', {level: 1});

  await expect(headings).toHaveLength(1);
  await expect(canvas.getAllByRole('main')).toHaveLength(1);
};
