import {QueryClient} from '@tanstack/react-query';
import type {DefaultOptions} from '@tanstack/react-query';

// The server builds a fresh client on every call because one server process
// renders many users' requests: a shared client would serve one user's cached
// data into another user's HTML. The browser holds one user, so it keeps a
// single client for the page's lifetime, which the provider and every
// clientLoader share. Nothing exports a client instance, so no module can
// capture one at import time on the server.

/** App-wide query defaults; stories and tests spread these and override. */
export const QUERY_DEFAULT_OPTIONS: DefaultOptions = {
  // Long enough that a clientLoader's prefetch is still fresh when the page's
  // useSuspenseQuery reads it, so navigation fetches once, not twice.
  queries: {staleTime: 30_000},
};

/** A new QueryClient with the app defaults, or the given ones. */
export const createQueryClient = (
  defaultOptions: DefaultOptions = QUERY_DEFAULT_OPTIONS
) => new QueryClient({defaultOptions});

let browserQueryClient: QueryClient | undefined;

/** Server: a new client per call. Browser: the page's one client. */
export const getQueryClient = () => {
  if (typeof window === 'undefined') return createQueryClient();

  browserQueryClient ??= createQueryClient();

  return browserQueryClient;
};

/**
 * Replaces the browser client, for stories and browser tests only, so the
 * provider and any clientLoader they run read the same fresh client.
 */
export const setBrowserQueryClient = (client: QueryClient) => {
  browserQueryClient = client;
};
