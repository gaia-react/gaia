      # pnpm, Node, and the frozen-lockfile install are the expensive half of
      # job setup, and they sit after the skip decision rather than before it.
      # A tick that decides to skip would otherwise pay a full install to
      # learn it has no work, and a private repository bills that in whole
      # rounded-up runner minutes. The decision itself needs neither: it runs
      # `gh` and the committed `.gaia/cli/gaia` bundle, both of which work
      # against the runner's preinstalled Node.
      #
      # All three carry the gate, not the install alone. setup-node's
      # `cache: 'pnpm'` post step saves the pnpm store unconditionally, so an
      # ungated setup-node above a skipped install would fail the job saving a
      # store that nothing created.
      #
      # The condition is `!= 'skip'` rather than `== 'run'` so this same
      # partial serves a job gated at the job level with no `pre_run` step of
      # its own: there the output is absent, which is not 'skip', so the setup
      # runs.
      - name: Setup pnpm
        if: steps.pre_run.outputs.decision != 'skip'
        uses: pnpm/action-setup@0977fd99725f1db4007ccb2928dbb4e90d06cc86 # v6.0.10
      - name: Setup Node
        if: steps.pre_run.outputs.decision != 'skip'
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version-file: '.node-version'
          cache: 'pnpm'
      - name: Install dependencies
        if: steps.pre_run.outputs.decision != 'skip'
        run: pnpm install --frozen-lockfile
