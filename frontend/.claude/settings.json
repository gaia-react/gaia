            "statusMessage": "Checking rm -rf safety…"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || printf %s \"${CLAUDE_PROJECT_DIR:-.}\")/.claude/hooks/pr-merge-audit-check.sh\"",
            "statusMessage": "Checking PR-merge audit gate…"
          },
          {
            "type": "command",
