  "sandbox": {
    "filesystem": {
      "denyRead": [
        "../.env",
        "../.env.*",
        "**/.env",
        "**/.env.*",
        "**/*.key",
        "**/*.pem",
        "**/*credential*",
        "**/secrets/**"
      ],
      "allowRead": [
        "../.env.example",
        "**/.env.example"
      ]
    }
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null || printf %s \"${CLAUDE_PROJECT_DIR:-.}\")/.gaia/statusline/gaia-statusline.sh\""
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  }
}
