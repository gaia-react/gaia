            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || printf %s \"${CLAUDE_PROJECT_DIR:-.}\")/.claude/hooks/block-sensitive-read.sh\""
          }
        ]
      },
      {
        "matcher": "Grep",
