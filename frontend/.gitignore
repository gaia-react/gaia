/.cache
/build
/public/build
.react-router/

# Testing
/playwright
.playwright/.cache/
.playwright/output/
coverage

# Per-tree ports, written by worktree provisioning
/.gaia-ports

# Storybook
/storybook-static/

# Vitest browser mode failure attachments
/.vitest/

# Optional eslint cache
.eslintcache
