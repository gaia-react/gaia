{
  "name": "frontend",
  "version": "1.6.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "install:browsers": "pnpm exec playwright install --with-deps",
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "shadcn": "shadcn",
    "msw:init": "msw init",
    "lint": "pnpm exec eslint --fix --max-warnings=0 --ext js,jsx,ts,tsx app --cache --cache-location ./node_modules/.cache/eslint .",
    "lint-dry": "pnpm exec eslint --fix-dry-run --max-warnings=0 --ext js,jsx,ts,tsx app --cache --cache-location ./node_modules/.cache/eslint .",
    "lint-all": "pnpm typecheck && pnpm lint && pnpm format && pnpm stylelint",
    "format": "prettier --write \"**/*.{ts,tsx,html,md,mdx,css,json}\"",
    "knip": "knip",
    "stylelint": "stylelint --fix app/**/*.css",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest",
    "test:ci": "vitest --run --passWithNoTests --coverage --bail 1",
    "test:lint-staged": "vitest --run --changed --passWithNoTests --bail 1",
    "pw": "pnpm exec playwright test",
    "pw-ui": "pnpm exec playwright test --ui",
    "chromatic": "pnpm exec chromatic --auto-accept-changes 'main' --storybook-build-dir 'storybook-static' --only-changed --exit-once-uploaded --exit-zero-on-changes --skip '@(renovate/**|dependabot/**)'",
    "storybook": "bash ../.gaia/scripts/storybook-launch.sh",
    "build-storybook": "storybook build --test"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@conform-to/react": "1.21.1",
    "@conform-to/zod": "1.21.1",
    "@epic-web/invariant": "1.0.0",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "cookie": "2.0.1",
    "date-fns": "4.4.0",
    "dotenv": "18.0.5",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "isbot": "5.2.2",
    "ky": "2.1.0",
    "lodash-es": "4.18.1",
    "lru-cache": "11.5.3",
    "lucide-react": "1.52.0",
    "nanoid": "6.0.2",
    "query-string": "9.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "react-router": "8.4.0",
    "remix-i18next": "8.0.0",
    "remix-toast": "4.0.0",
    "remix-utils": "10.0.0",
    "spark-md5": "3.0.2",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "8.0.6",
    "@faker-js/faker": "10.6.0",
    "@gaia-react/lint": "3.0.0-rc.3",
    "@msw/data": "1.1.8",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@react-router/fs-routes": "8.4.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-links": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/accept-language-parser": "1.5.8",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/spark-md5": "3.0.5",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@vueless/storybook-dark-mode": "10.0.8",
    "accept-language-parser": "1.5.0",
    "babel-plugin-react-compiler": "1.0.0",
    "bippy": "0.7.3",
    "chromatic": "18.11.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "knip": "6.39.0",
    "msw": "3.0.2",
    "msw-storybook-addon": "3.0.3",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "shadcn": "4.21.3",
    "storybook": "10.6.1",
    "storybook-react-i18next": "10.1.4",
    "stylelint": "17.16.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
