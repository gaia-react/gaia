{
  "name": "gaia",
  "version": "1.6.1",
  "description": "GAIA: The React workflow for Claude",
  "author": "Steven Sacks <stevensacks@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "private": true,
  "gaia": {
    "updateDepsHold": {
      "typescript": "6.0"
    },
    "wikiClassify": {
      "sourcePaths": [
        ".claude/agents/",
        ".claude/commands/",
        ".claude/hooks/",
        ".claude/rules/",
        ".claude/skills/",
        ".gaia/cli/src/",
        ".gaia/scripts/",
        ".gaia/statusline/",
        "frontend/app/"
      ],
      "testPaths": [
        ".gaia/tests/",
        ".gaia/scripts/tests/"
      ]
    }
  },
  "bin": {
    "gaia": "./.gaia/cli/gaia"
  },
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || [ ! -e .git ] || git config core.hooksPath .githooks",
    "lint:cli": "pnpm -C .gaia/cli lint",
    "test:forensics": "bash .gaia/tests/forensics/run-all.sh",
    "test:sandbox": "bash .gaia/tests/sandbox/run-all.sh",
    "install:browsers": "pnpm -C frontend install:browsers",
    "build": "pnpm -C frontend build",
    "dev": "pnpm -C frontend dev",
    "start": "pnpm -C frontend start",
    "lint": "pnpm -C frontend lint",
    "lint-dry": "pnpm -C frontend lint-dry",
    "lint-all": "pnpm -C frontend lint-all",
    "format": "prettier --write \"**/*.{ts,tsx,html,md,mdx,css,json}\" && pnpm -C frontend format",
    "knip": "pnpm -C frontend knip",
    "stylelint": "pnpm -C frontend stylelint",
    "typecheck": "pnpm -C frontend typecheck",
    "test": "pnpm -C frontend test",
    "test:ci": "pnpm -C frontend test:ci",
    "test:lint-staged": "pnpm -C frontend test:lint-staged",
    "pw": "pnpm -C frontend pw",
    "pw-ui": "pnpm -C frontend pw-ui",
    "chromatic": "pnpm -C frontend chromatic",
    "storybook": "pnpm -C frontend storybook",
    "build-storybook": "pnpm -C frontend build-storybook"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@gaia-react/lint": "3.0.0-rc.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@12.7.0+sha512.9c56477e360068d6e9dca6a92efb4e46b3dc5a52fcebf3d84d78b9736c0ded589a561621a52f68219a7a39facc63cdc079c3226ef9c9d5f02b79f74e69a807b6"
}
